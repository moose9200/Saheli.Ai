# --- required ---
# Gemini API key. Without it /api/chat and Gemini speech fail; /api/health still works.
GEMINI_API_KEY=

# --- optional: model overrides (defaults shown) ---
# CHAT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_STT_MODEL=gemini-3.5-transcribe

# --- optional: Indic-Speak (best accent fidelity, native voices) ---
# Hosted API, OpenAI-compatible. Leave blank to fall back to Gemini TTS.
# INDIC_SPEAK_API_KEY=
# INDIC_SPEAK_BASE_URL=https://api.bodhan.ai/v1
# INDIC_SPEAK_MODEL=indic-speak

# --- server ---
PORT=3000
NODE_ENV=production

# --- SECURITY: never set this in production ---
# When unset, any x-tenant-id other than "demo" is rejected with 403 (fail closed).
# Setting it accepts ANY tenant id, which means anyone can read any household.
# It exists only so a local demo can switch tenants before auth exists.
# ALLOW_UNVERIFIED_TENANTS=
